#!/usr/bin/env python3
"""Validate the project's Conventional Commit message format."""

import re
import sys
from pathlib import Path

message = Path(sys.argv[1]).read_text(encoding="utf-8")
lines = message.splitlines()
header = lines[0] if lines else ""
pattern = (
    r"(?:feat|fix|refactor|perf|docs|test|chore|build|ci|style|revert)"
    r"(?:\([a-z0-9][a-z0-9._/-]*\))?!?: [a-z0-9][^\r\n]*"
)
if (
    not re.fullmatch(pattern, header)
    or len(header) > 72
    or header.endswith(".")
    or header != header.rstrip()
    or (len(lines) > 1 and lines[1] != "")
):
    sys.exit(
        "Invalid commit message. Use type(scope): imperative summary\n"
        "Types: feat, fix, refactor, perf, docs, test, chore, build, ci, style, revert\n"
        "Scope optional; ! allowed before colon. Lowercase summary start; "
        "header <=72 characters; no trailing period/space.\n"
        "Separate any body from the header with a blank line."
    )
